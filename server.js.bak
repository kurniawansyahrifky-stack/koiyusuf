// API REVIEWS
app.get('/api/reviews', (req, res) => {
  db.all("SELECT * FROM reviews ORDER BY id DESC", [], (err, rows) => {
    if (err) return res.status(500).json({ error: err.message });
    res.json(rows || []);
  });
});

app.post('/api/reviews', (req, res) => {
  const { customer_name, customer_phone, rating, comment, variety_bought } = req.body;
  const cleanPhone = (customer_phone || '').replace(/\D/g, '');
  db.get("SELECT * FROM bidders WHERE phone = ?", [cleanPhone], (err, row) => {
    if (err || !row) {
      return res.status(403).json({ error: "Ulasan hanya bisa dikirim oleh pembeli yang nomor WA-nya terdaftar di sistem!" });
    }
    db.run(
      "INSERT INTO reviews (customer_name, customer_phone, rating, comment, variety_bought) VALUES (?, ?, ?, ?, ?)",
      [customer_name, cleanPhone, parseInt(rating) || 5, comment, variety_bought || 'Nishikigoi'],
      function (err2) {
        if (err2) return res.status(500).json({ error: err2.message });
        res.json({ success: true });
      }
    );
  });
});

