  });
});

app.post('/api/auctions', upload.single('imageFile'), (req, res) => {
  const { code, koi_name, variety, size_cm, gender, breeder, open_bid, bid_step, end_time } = req.body;
  const img = req.file ? `/uploads/${req.file.filename}` : '/uploads/hero-koi-1.jpg';
  const ob = parseInt(open_bid) || 1000000;
  db.run(
    "INSERT INTO auctions (code, koi_name, variety, size_cm, gender, breeder, open_bid, bid_step, current_bid, end_time, image) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
    [code || 'A', koi_name, variety, parseInt(size_cm) || 30, gender, breeder, ob, parseInt(bid_step) || 50000, ob, end_time, img],
    function (err) {
      if (err) return res.status(500).json({ error: err.message });
      res.json({ success: true, id: this.lastID });
    }
  );
});

app.post('/api/auctions/toggle/:id', (req, res) => {
